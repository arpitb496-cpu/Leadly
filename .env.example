# Backend Configuration
FLASK_APP=backend/app.py
FLASK_ENV=development
PORT=5001
# PostgreSQL connection string on Render, or leave blank to fall back to SQLite locally
DATABASE_URL=
# Comma-separated origins for CORS (e.g. https://leadly.onrender.com,http://localhost:5173 or * for all)
ALLOWED_ORIGINS=*
SECRET_KEY=dev-secret-key-change-in-production

# Frontend Configuration
# Backend API URL for production (e.g. https://leadly-api.onrender.com/api), or leave empty for local /api proxy
VITE_API_URL=
